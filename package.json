{
  "name": "guvio",
  "version": "1.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "iphone": "expo start --go --tunnel --clear",
    "lan": "expo start --go --lan --clear",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "share:web": "expo start --web --lan",
    "build:apk": "eas build -p android --profile preview",
    "build:android": "eas build -p android --profile preview",
    "build:android:playstore": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:all": "eas build --platform all --profile preview",
    "build:web": "expo export --platform web",
    "update": "eas update --auto",
    "update:preview": "eas update --branch preview --message \"Atualizacao Guvio\"",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.0.0",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-gl": "~16.0.10",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-updates": "~29.0.20",
    "lucide-react-native": "^1.27.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@types/three": "^0.174.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
