{
  "expo": {
    "name": "Guvio",
    "slug": "guvio",
    "scheme": "guvio",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/eb78cc29-c0da-4637-b6cc-efe73650bff6"
    },
    "runtimeVersion": "1.1.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.guvio.ios",
      "buildNumber": "33"
    },
    "android": {
      "package": "app.guvio.android",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050608"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "eb78cc29-c0da-4637-b6cc-efe73650bff6"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Guvio usa sua localização para marcar a cidade dos seus looks e mostrar o clima."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Guvio acessa suas fotos para você publicar looks, stories e peças do guarda-roupa.",
          "cameraPermission": "O Guvio usa a câmera para você fotografar seus looks.",
          "microphonePermission": "O Guvio usa o microfone para gravar vídeos dos seus looks."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050608"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Guvio acessa suas fotos e vídeos para você publicar looks, stories e peças do guarda-roupa.",
          "savePhotosPermission": "O Guvio salva imagens dos seus looks na galeria quando você pede.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111",
          "defaultChannel": "default"
        }
      ]
    ],
    "backgroundColor": "#050608"
  }
}
